{
  "name": "novaforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A 2D game engine and visual editor built from scratch in plain JavaScript.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "docs-site"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "dev": "npm run dev --workspace @novaforge/example-breakout",
    "bench": "node --expose-gc benchmarks/run.js",
    "bench:browser": "node benchmarks/run-browser.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "verify:treeshaking": "node scripts/verify-treeshaking.mjs",
    "docs:dev": "npm run dev --workspace docs-site",
    "docs:build": "node scripts/build-docs-site.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "marked": "^18.0.9",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
