{
  "name": "@novaforge/editor",
  "version": "0.1.0",
  "type": "module",
  "description": "A browser-based visual editor for NovaForge scenes: scene tree, schema-driven inspector, viewport selection, undo/redo, and asset hot-reload.",
  "license": "MIT",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./style.css": "./src/style.css"
  },
  "files": ["src"],
  "sideEffects": ["./src/style.css"],
  "dependencies": {
    "@novaforge/animation": "0.1.0",
    "@novaforge/audio": "0.1.0",
    "@novaforge/core": "0.1.0",
    "@novaforge/input": "0.1.0",
    "@novaforge/math": "0.1.0",
    "@novaforge/physics": "0.1.0",
    "@novaforge/renderer": "0.1.0",
    "@novaforge/runtime": "0.1.0"
  }
}
